# Build outputs and images -- never commit multi-GB payloads.
*.img
*.bin
*.zip
*.gz
*.xz
*.tar
out/
build/

# Firmware and OS images (your own downloads). Multi-GB; never tracked.
firmware/
*.bz2
*.img.*

# Python bytecode
__pycache__/
*.pyc

# Device captures from your own runs
captures/

# Allowed exceptions: synthetic kgate test fixtures (generated by
# tools/kgate/fixtures/make_fixtures.py; no Meta or Valve bytes) and the Quest 2
# channel's symbol list (text only; the fs-rpcd binary is never committed).
!tools/kgate/fixtures/data/**
!devices/quest2/channel/build/
devices/quest2/channel/build/*
!devices/quest2/channel/build/fs-rpcd.undef

# Local tool state
.claude/

# Third-party analysis tools; never tracked
tools/perfetto/
