# Build outputs and images -- never commit multi-GB payloads.
*.img
*.bin
*.zip
*.gz
*.xz
*.tar
out/
build/

# Firmware and OS images. Multi-GB; never tracked.
# firmware/SteamOS/ holds the published Steam Frame ARM image.
firmware/
*.bz2
*.img.*

# Relay evidence bundles contain third-party (Valve) files.
# Keep them local; track only the hash manifest.
relays/*-bundle/*
!relays/*-bundle/MANIFEST.sha256

# Python bytecode
__pycache__/
*.pyc

# Device captures (per-attempt evidence; bundled explicitly when reported)
captures/
# ...but relay evidence folders keep their captures (J-116: FS-A-012-raw captures were silently ignored)
!relays/*-raw/captures/
!relays/*-raw/**/captures/
!relays/*-raw/**/captures/**

# Allowed exceptions (public copy): synthetic kgate test fixtures (generated by
# tools/kgate/fixtures/make_fixtures.py; no Meta/Valve bytes) and the Quest 2
# channel build record (text only; the fs-rpcd binary is never committed).
!tools/kgate/fixtures/data/**
!devices/quest2/channel/build/
devices/quest2/channel/build/*
!devices/quest2/channel/build/BUILD.txt
!devices/quest2/channel/build/fs-rpcd.undef

# local tool state
.claude/

# Perfetto trace_processor for PC-side analysis (D-O2, J-172); third-party binary, never tracked
tools/perfetto/
