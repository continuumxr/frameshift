+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * fs-blkguard: FrameShift boot-chain block-write guard (hooks).
+ *
+ * Every hook returns true when the operation must be refused.  The caller
+ * then fails it with -EPERM (or BLK_STS_IOERR at the bio layer).  Hooks are
+ * placed before the kernel's own mode and capability checks, so that a
+ * refusal is counted even for a caller that the kernel would also refuse.
+ *
+ * Copyright (C) 2026 FrameShift contributors
+ */
+#ifndef _LINUX_FS_BLKGUARD_H
+#define _LINUX_FS_BLKGUARD_H
+
+#include <linux/types.h>
+
+struct gendisk;
+struct bio;
+
+enum fs_blkguard_path {
+	FSBG_PATH_OPEN,		/* block device open with FMODE_WRITE */
+	FSBG_PATH_WRITE,	/* write(2)/pwrite/aio/io_uring on a bdev file */
+	FSBG_PATH_FALLOCATE,	/* fallocate(2) on a bdev file */
+	FSBG_PATH_DISCARD,	/* BLKDISCARD, BLKSECDISCARD */
+	FSBG_PATH_ZEROOUT,	/* BLKZEROOUT */
+	FSBG_PATH_ROSET,	/* BLKROSET clearing read-only */
+	FSBG_PATH_BLKPG,	/* BLKPG add/delete/resize partition */
+	FSBG_PATH_RRPART,	/* BLKRRPART partition rescan */
+	FSBG_PATH_BIO,		/* any write-class bio (fs, dm, md, loop, swap, mmap) */
+	FSBG_PATH_SCSI,		/* SG_IO / SCSI_IOCTL_SEND_COMMAND on sd, bsg-scsi */
+	FSBG_PATH_SG,		/* /dev/sg* write(2) and SG_IO */
+	FSBG_PATH_BSG,		/* transport bsg (UFS BSG query/UIC, FC, SAS) */
+	FSBG_PATH_SCSI_IOCTL,	/* SCSI host-driver ioctls (UFS_IOCTL_QUERY), START/STOP UNIT,
+				 * SG_SCSI_RESET, CDROMEJECT/CDROMCLOSETRAY */
+	FSBG_PATH_PR,		/* IOC_PR_* persistent reservations */
+	FSBG_PATH_NR
+};
+
+bool fs_blkguard_deny_bdev(struct gendisk *disk, int partno,
+			   enum fs_blkguard_path path);
+bool fs_blkguard_deny_bio(struct bio *bio);
+bool fs_blkguard_deny_cdb(const unsigned char *cdb, unsigned int len,
+			  enum fs_blkguard_path path);
+bool fs_blkguard_deny_transport(enum fs_blkguard_path path);
+bool fs_blkguard_deny_scsi_ioctl(unsigned int cmd);
+
+#endif /* _LINUX_FS_BLKGUARD_H */
