                                                                                         || { echo "FSVE1 error=step3 END"; exit 1; }
-fsb1_run "$REC" 4 list   "$D" $T -- "$L" --inhibit-cache --library-path "$LP" --list /valve/bin/b2sum \
+# FS-A-009 §4 option B (NOT ADOPTED, FS-R-009 §4): LD_TRACE_LOADED_OBJECTS=1 makes ld.so write
+# mode_trace_program false, so the unnamed main-map line is never printed (qemu 15/15).
+fsb1_run "$REC" 4 list   "$D" $T -e LD_TRACE_LOADED_OBJECTS=1 -- "$L" --inhibit-cache --library-path "$LP" --list /valve/bin/b2sum \
                                                                                         || { echo "FSVE1 error=step4 END"; exit 1; }
 fsb1_run "$REC" 5 uname  "$D" $T -- "$L" --inhibit-cache --library-path "$LP" /valve/bin/uname -r \
                                                                                         || { echo "FSVE1 error=step5 END"; exit 1; }
