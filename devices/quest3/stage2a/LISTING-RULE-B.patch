diff --git a/devices/quest3/common/target/fsb1-enc.sh b/devices/quest3/common/target/fsb1-enc.sh
index 261c84d..a337dee 100644
--- a/devices/quest3/common/target/fsb1-enc.sh
+++ b/devices/quest3/common/target/fsb1-enc.sh
@@ -63,18 +63,24 @@ fsb1_step() {  # fsb1_step REC I ID FSUPFILE OUTFILE ERRFILE
     _fsb1_data "$1" "$2" e "$6"
 }
 
-fsb1_run() {  # fsb1_run REC I ID DIR TIMEOUT [-i INFILE] -- /ABS/PROG [ARG]...
-    local rec i id dir t inopt
+fsb1_run() {  # fsb1_run REC I ID DIR TIMEOUT [-i INFILE] [-e KEY=VAL] -- /ABS/PROG [ARG]...
+    local rec i id dir t inopt envopt
     rec=$1 i=$2 id=$3 dir=$4 t=$5
     shift 5
     _fsb1_num "$i" && _fsb1_tok "$id" && _fsb1_num "$t" || return 2
-    inopt=""
+    inopt="" envopt=""
     if [ "$1" = "-i" ]; then inopt=$2; shift 2; fi
+    # at most one -e, passed through to fs-supervise (which applies its own refusal list)
+    if [ "$1" = "-e" ]; then envopt=$2; shift 2; [ -n "$envopt" ] || return 2; fi
     [ "$1" = "--" ] || return 2
     shift
     [ -e "$dir/$i.out" ] || [ -e "$dir/$i.err" ] || [ -e "$dir/$i.sup" ] && return 3
-    if [ -n "$inopt" ]; then
+    if [ -n "$inopt" ] && [ -n "$envopt" ]; then
+        "$FSB1_SUP" -t "$t" -i "$inopt" -e "$envopt" -o "$dir/$i.out" -r "$dir/$i.err" -- "$@" > "$dir/$i.sup" 2>/dev/null
+    elif [ -n "$inopt" ]; then
         "$FSB1_SUP" -t "$t" -i "$inopt" -o "$dir/$i.out" -r "$dir/$i.err" -- "$@" > "$dir/$i.sup" 2>/dev/null
+    elif [ -n "$envopt" ]; then
+        "$FSB1_SUP" -t "$t" -e "$envopt" -o "$dir/$i.out" -r "$dir/$i.err" -- "$@" > "$dir/$i.sup" 2>/dev/null
     else
         "$FSB1_SUP" -t "$t" -o "$dir/$i.out" -r "$dir/$i.err" -- "$@" > "$dir/$i.sup" 2>/dev/null
     fi
